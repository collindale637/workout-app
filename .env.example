# From Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where exercise pictures load from. Leave blank to use the public free-exercise-db images on GitHub;
# after running scripts/upload-exercise-images.mjs set it to:
# https://YOUR-PROJECT.supabase.co/storage/v1/object/public/exercise-images
NEXT_PUBLIC_EXERCISE_IMAGE_BASE=

# Server-only. Needed for the image upload script, never in the browser.
SUPABASE_SECRET_KEY=

# Server-only. AI features (Claude API). Leave blank to run without AI.
ANTHROPIC_API_KEY=
# Family-wide monthly AI spend limit in US dollars (default 10).
AI_MONTHLY_CAP_USD=10
# Claude model (default claude-sonnet-5-5).
AI_MODEL=
